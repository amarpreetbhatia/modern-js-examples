{
  "name": "host",
  "version": "0.1.0",
  "scripts": {
    "reset": "npx rimraf node_modules ./**/node_modules",
    "dev": "modern dev",
    "build": "modern build",
    "start": "modern start",
    "serve": "modern serve",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "prepare": "simple-git-hooks"
  },
  "engines": {
    "node": ">=20.19.5"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --files-ignore-unknown=true"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "dependencies": {
    "@modern-js/runtime": "3.1.5",
    "@module-federation/modern-js-v3": "^2.4.0",
    "react": "~18.2.0",
    "react-dom": "~18.2.0",
    "react-router": "^7.15.0",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@modern-js/app-tools": "3.1.5",
    "@modern-js/tsconfig": "3.1.5",
    "@types/jest": "~29.2.4",
    "@types/node": "~16.11.7",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "lint-staged": "~13.1.0",
    "rimraf": "^6.0.1",
    "simple-git-hooks": "^2.11.1",
    "typescript": "~5.0.4"
  },
  "resolutions": {
    "@types/react": "18.3.27"
  }
}
